# Keep the build context small and secret-free.
.git
.gitignore
.github
.secrets
*.sqlite3
db.sqlite3
**/__pycache__/
*.pyc
*.pyo
.venv
venv/
env/
node_modules/
staticfiles/
media/
.env
.env.*
!deploy/.env.example
infra/**/.terraform/
infra/**/*.tfstate*
*.log
.DS_Store
.idea/
.vscode/
requirements-dev.txt
tests/
**/tests.py
