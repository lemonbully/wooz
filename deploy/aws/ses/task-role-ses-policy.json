{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendOneWoozMailViaSES",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "ses:FromAddress": [
            "*@via.onewooz.website",
            "*@onewooz.com",
            "*@myugcstore.com"
          ]
        }
      }
    }
  ]
}
