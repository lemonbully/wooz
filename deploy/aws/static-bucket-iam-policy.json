{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StaticBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::onewooz-static-bucket"
    },
    {
      "Sid": "StaticBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::onewooz-static-bucket/*"
    }
  ]
}
